# La app Flutter NO lee un .env: la URL del backend se pasa al compilar/ejecutar.
#   flutter run --dart-define=API_URL=http://10.0.2.2:8080     (emulador Android, valor por defecto)
#   flutter run --dart-define=API_URL=http://192.168.1.50:8080 (teléfono físico, IP de tu PC)
# Los secretos del servidor (JWT_SECRET, ANTHROPIC_API_KEY) van en backend/.env (ver backend/.env.example).
API_URL=http://10.0.2.2:8080
