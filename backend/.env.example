# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
PORT=8080
# Cadena aleatoria larga (mínimo 16 caracteres), p. ej.: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Opcional: si no se define, el asistente usa un resumen local sin modelo.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
DATA_FILE=data/db.json
